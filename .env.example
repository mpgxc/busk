# Copie para .env e troque TODOS os valores antes de subir.
# A API recusa JWT_SECRET e ADMIN_TOKEN que começam com "troque".
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
ADMIN_TOKEN=troque-por-um-token-admin-longo

# Sem Docker: aponte para o seu Postgres local
DATABASE_URL=postgres://postgres:troque-por-uma-senha-forte@localhost:5432/comparai?sslmode=disable

# Opcionais (valores padrão)
# ADDR=:8080
# DB_MAX_CONNS=20
# JWT_TTL=24h
# ALERTS_INTERVAL=1m
# STALE_OFFER_AFTER=72h
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=40
# CORS_ORIGINS=          # vazio = sem CORS (o frontend é same-origin)
# TRUST_PROXY=false
# DISABLE_WORKER=false
